    "folders.pinnedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pinned tab cannot be renamed or deleted. Use Pin / Unpin on clips to manage its contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「已固定」标签无法重命名或删除。在剪贴项上使用固定/取消固定来管理内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ピン留め」タブは名前変更・削除できません。項目のピン留め/解除で内容を管理します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onglet Épinglés ne peut pas être renommé ni supprimé. Utilisez Épingler / Désépingler sur les éléments."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab Angeheftet kann nicht umbenannt oder gelöscht werden. Anheften/Lösen über die Einträge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Fijados no se puede renombrar ni eliminar. Usa Fijar / Desfijar en los elementos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty Przypięte nie można zmienić nazwy ani usunąć. Użyj Przypnij / Odepnij na elementach."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「已釘選」標籤無法重新命名或刪除。請在項目上使用「釘選／取消釘選」來管理內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정됨 탭은 이름을 바꾸거나 삭제할 수 없습니다. 항목의 고정/고정 해제로 내용을 관리하세요."
          }
        }
      }
    },
