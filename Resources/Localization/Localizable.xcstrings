    "privacy.eventsBlurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events help improve Paste It (activation, panel use, updates). Data is anonymous and sent to PostHog when enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件数据有助于改进 Paste It（激活、面板使用、更新等）。启用后匿名发送至 PostHog。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントは Paste It の改善に役立ちます（有効化、パネル利用、アップデートなど）。有効時は匿名で PostHog に送信されます。"
          }
        }
