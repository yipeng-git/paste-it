    "privacy.analyticsFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Off means no events are sent. See %@ in the open-source repo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。关闭后不会发送任何事件。详见开源仓库中的 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。オフの場合イベントは送信されません。オープンソースリポジトリの %@ を参照してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Désactivé = aucun événement envoyé. Voir %@ dans le dépôt open source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Aus = keine Ereignisse. Siehe %@ im Open-Source-Repo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Desactivado = no se envían eventos. Consulta %@ en el repositorio abierto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Wyłączone = brak zdarzeń. Zobacz %@ w repozytorium open source."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選。關閉後不會傳送任何事件。詳見開放原始碼存放庫中的 %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 끄면 이벤트가 전송되지 않습니다. 오픈 소스 저장소의 %@를 참고하세요."
          }
        }
      }
    },
