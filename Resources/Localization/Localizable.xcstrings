          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 일반 텍스트로 붙여넣기"
          }
        }
      }
    },
    "settings.plainTextFootnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V pastes once as plain text, then restores the original clipboard (Accessibility required to auto-paste). In the timeline, ⇧↩ pastes the selection as plain text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V 会粘贴一次纯文本，然后恢复原来的剪贴板内容（自动粘贴需要辅助功能权限）。在时间轴中，⇧↩ 会将所选内容粘贴为纯文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V で一度プレーンテキストをペーストし、元のクリップボードを復元します（自動ペーストにはアクセシビリティが必要）。タイムラインでは ⇧↩ で選択項目をプレーンテキストとしてペーストします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V colle une fois en texte brut, puis restaure le presse-papiers d'origine (accessibilité requise pour le collage auto). Dans l'historique, ⇧↩ colle la sélection en texte brut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V fügt einmal als Text ein und stellt die ursprüngliche Zwischenablage wieder her (Bedienungshilfen für Auto-Einfügen). Im Verlauf fügt ⇧↩ die Auswahl als Text ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V pega una vez como texto plano y restaura el portapapeles original (se requiere accesibilidad para pegado automático). En el historial, ⇧↩ pega la selección como texto plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V wkleja raz jako zwykły tekst, potem przywraca oryginalny schowek (wymagana dostępność do auto-wklejania). W historii ⇧↩ wkleja zaznaczenie jako zwykły tekst."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V 會貼上一次純文字，然後還原原本的剪貼簿內容（自動貼上需要「輔助使用」）。在時間軸中，⇧↩ 會以純文字貼上選取項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌘V는 한 번 일반 텍스트로 붙여넣은 뒤 원래 클립보드를 복원합니다(자동 붙여넣기에는 손쉬운 사용이 필요합니다). 타임라인에서는 ⇧↩로 선택 항목을 일반 텍스트로 붙여넣습니다."
          }
        }
      }
    },
