    "privacy.eventsBlurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events help improve Paste It (activation, panel use, updates). Data is anonymous and sent to PostHog when enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件数据有助于改进 Paste It（激活、面板使用、更新等）。启用后匿名发送至 PostHog。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントは Paste It の改善に役立ちます（有効化、パネル利用、アップデートなど）。有効時は匿名で PostHog に送信されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements aident à améliorer Paste It (activation, panneau, mises à jour). Les données sont anonymes et envoyées à PostHog si activé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse helfen, Paste It zu verbessern (Aktivierung, Panel, Updates). Daten sind anonym und werden bei Aktivierung an PostHog gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos ayudan a mejorar Paste It (activación, panel, actualizaciones). Los datos son anónimos y se envían a PostHog si está activado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarzenia pomagają ulepszać Paste It (aktywacja, panel, aktualizacje). Dane są anonimowe i wysyłane do PostHog po włączeniu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件資料有助於改進 Paste It（啟用、面板使用、更新等）。啟用後會以匿名方式傳送至 PostHog。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트는 Paste It 개선(활성화, 패널 사용, 업데이트 등)에 도움이 됩니다. 켜면 익명으로 PostHog에 전송됩니다."
          }
        }
      }
    },
