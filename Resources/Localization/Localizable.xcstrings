    "settings.aboutBlurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste It is a local-first clipboard manager. History stays on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste It 是一款本地优先的剪贴板管理器。历史记录仅保存在本 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste It はローカル優先のクリップボードマネージャーです。履歴はこの Mac にのみ保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste It est un gestionnaire de presse-papiers local. L'historique reste sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
