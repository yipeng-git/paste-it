    "onboarding.capture.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anything — Paste It saves it and flashes ⌘C in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制任意内容 — Paste It 会保存并在菜单栏闪烁 ⌘C。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でもコピー — Paste It が保存し、メニューバーで ⌘C を点滅させます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez n'importe quoi — Paste It l'enregistre et affiche ⌘C dans la barre de menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles kopieren — Paste It speichert es und blinkt ⌘C in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia cualquier cosa — Paste It la guarda y muestra ⌘C en la barra de menús."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj cokolwiek — Paste It zapisuje i miga ⌘C na pasku menu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製任何內容 — Paste It 會保存，並在選單列閃爍 ⌘C。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 복사하세요. Paste It이 저장하고 메뉴 막대에서 ⌘C를 깜빡입니다."
          }
        }
      }
    },
    "onboarding.paste.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V opens history. Double-click a clip, then ⌘V — or ⌃⌘V to paste without formatting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V 打开历史。双击剪贴项后按 ⌘V — 或 ⌃⌘V 无格式粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V で履歴を開く。項目をダブルクリックして ⌘V — または ⌃⌘V で書式なしペースト。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V ouvre l'historique. Double-cliquez un élément, puis ⌘V — ou ⌃⌘V sans mise en forme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V öffnet den Verlauf. Doppelklick auf Eintrag, dann ⌘V — oder ⌃⌘V ohne Formatierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V abre el historial. Doble clic en un elemento, luego ⌘V — o ⌃⌘V sin formato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V otwiera historię. Kliknij dwukrotnie element, potem ⌘V — lub ⌃⌘V bez formatowania."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V 打開歷史記錄。在項目上按兩下，再按 ⌘V — 或按 ⌃⌘V 以純文字貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V로 기록을 엽니다. 항목을 두 번 클릭한 뒤 ⌘V — 또는 ⌃⌘V로 서식 없이 붙여넣습니다."
          }
        }
      }
    },
    "onboarding.browse.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Space to preview above the timeline. Click the text to edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格键在时间线上方预览。点击文本可编辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースでタイムライン上にプレビュー。テキストをクリックして編集。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Espace pour prévisualiser au-dessus de l'historique. Cliquez le texte pour modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leertaste für die Vorschau über dem Verlauf. Text anklicken zum Bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Espacio para previsualizar sobre el historial. Haz clic en el texto para editar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Spację, aby podejrzeć nad historią. Kliknij tekst, aby edytować."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按空白鍵可在時間軸上方預覽。點一下文字即可編輯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 눌러 타임라인 위에서 미리봅니다. 텍스트를 클릭해 편집하세요."
          }
        }
      }
    },
    "onboarding.organize.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click several clips, then press Return to paste them in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-点击多个剪贴项，然后按 Return 按顺序粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-クリックで複数選択し、Return で順にペースト。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-cliquez plusieurs éléments, puis Entrée pour les coller dans l'ordre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-Klick auf mehrere Einträge, dann Eingabe zum Einfügen in Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-clic en varios elementos, luego Intro para pegarlos en orden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-kliknij kilka elementów, potem Return, aby wkleić w kolejności."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-點選多個項目，再按 Return 依序貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-클릭으로 여러 항목을 고른 뒤 Return으로 순서대로 붙여넣습니다."
          }
        }
      }
    },
    "onboarding.stack.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C opens a queue on the right. Copy several things, then ⌘V in the target app to paste them one by one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 在右侧打开队列。复制多项后，在目标应用中按 ⌘V 逐一粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C で右にキューを開く。複数コピー後、対象アプリで ⌘V を押して順にペースト。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C ouvre une file à droite. Copiez plusieurs éléments, puis ⌘V dans l'app cible un par un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C öffnet eine Warteschlange rechts. Mehrere Dinge kopieren, dann ⌘V in der Ziel-App nacheinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C abre una cola a la derecha. Copia varias cosas, luego ⌘V en la app destino una a una."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C otwiera kolejkę po prawej. Skopiuj kilka rzeczy, potem ⌘V w docelowej aplikacji po kolei."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 會在右側打開佇列。複製多項內容後，在目標 App 中按 ⌘V 逐一貼上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C로 오른쪽에 대기열을 엽니다. 여러 항목을 복사한 뒤 대상 App에서 ⌘V로 하나씩 붙여넣으세요."
          }
        }
      }
    },
