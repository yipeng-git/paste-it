    "onboarding.capture.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anything — Paste It saves it and flashes ⌘C in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制任意内容 — Paste It 会保存并在菜单栏闪烁 ⌘C。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何でもコピー — Paste It が保存し、メニューバーで ⌘C を点滅させます。"
          }
        }
      }
    },
    "onboarding.paste.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V opens history. Double-click a clip, then ⌘V — or ⌃⌘V to paste without formatting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V 打开历史。双击剪贴项后按 ⌘V — 或 ⌃⌘V 无格式粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘V で履歴を開く。項目をダブルクリックして ⌘V — または ⌃⌘V で書式なしペースト。"
          }
        }
      }
    },
    "onboarding.browse.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Space to preview above the timeline. Click the text to edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格键在时间线上方预览。点击文本可编辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースでタイムライン上にプレビュー。テキストをクリックして編集。"
          }
        }
      }
    },
    "onboarding.organize.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click several clips, then press Return to paste them in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-点击多个剪贴项，然后按 Return 按顺序粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-クリックで複数選択し、Return で順にペースト。"
          }
        }
      }
    },
    "onboarding.stack.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C opens a queue on the right. Copy several things, then ⌘V in the target app to paste them one by one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C 在右侧打开队列。复制多项后，在目标应用中按 ⌘V 逐一粘贴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘C で右にキューを開く。複数コピー後、対象アプリで ⌘V を押して順にペースト。"
          }
        }
      }
    },
