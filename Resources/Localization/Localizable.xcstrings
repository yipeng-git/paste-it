    "privacy.ignoredAppsFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies made in these apps are never saved to history. Use this for password managers and other sensitive apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用中的复制内容不会保存到历史。适用于密码管理器等敏感应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリでのコピーは履歴に保存されません。パスワードマネージャーなどに使用してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies dans ces apps ne sont jamais enregistrées. Utile pour les gestionnaires de mots de passe et apps sensibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien in diesen Apps werden nie gespeichert. Für Passwort-Manager und sensible Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias en estas apps nunca se guardan. Útil para gestores de contraseñas y apps sensibles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie w tych aplikacjach nie są zapisywane. Dla menedżerów haseł i wrażliwych aplikacji."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 App 中的複製內容不會存入歷史記錄。適用於密碼管理工具等敏感 App。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 App에서 복사한 내용은 기록에 저장되지 않습니다. 비밀번호 관리자 등 민감한 App에 사용하세요."
          }
        }
      }
    },
    "privacy.protectedContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected Content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护内容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたコンテンツ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu protégé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützter Inhalt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido protegido"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroniona zawartość"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受保護內容"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 콘텐츠"
          }
        }
      }
    },
    "privacy.protectedBlurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive clipboard markers from apps — such as password fields and temporary clips — are ignored automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自应用的敏感剪贴板标记（如密码字段和临时剪贴）会自动忽略。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード欄や一時クリップなど、アプリの機密クリップボードマーカーは自動的に無視されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les marqueurs sensibles du presse-papiers — champs de mot de passe, clips temporaires — sont ignorés automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Zwischenablage-Markierungen — Passwortfelder, temporäre Clips — werden automatisch ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores sensibles del portapapeles — campos de contraseña, clips temporales — se ignoran automáticamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrażliwe znaczniki schowka — pola haseł, tymczasowe klipy — są automatycznie ignorowane."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 App 的敏感剪貼簿標記（例如密碼欄位、暫時剪貼內容）會自動忽略。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 필드나 임시 클립처럼 App이 표시한 민감한 클립보드 데이터는 자동으로 무시됩니다."
          }
        }
      }
    },
    "privacy.protectedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignored Apps skip everything from a whole app. Protected Content skips only marked sensitive pasteboard data, from any app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略的应用会跳过整个应用的所有内容。受保护内容仅跳过任何应用中标记为敏感的剪贴板数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視するアプリはアプリ全体をスキップします。保護されたコンテンツは、任意のアプリで機密とマークされたペーストボードデータのみをスキップします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps ignorées excluent toute une app. Contenu protégé exclut uniquement les données sensibles marquées, de toute app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorierte Apps überspringen alles von einer App. Geschützter Inhalt nur markierte sensible Daten, von jeder App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps ignoradas omiten todo de una app. Contenido protegido solo omite datos sensibles marcados, de cualquier app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorowane aplikacje pomijają całą aplikację. Chroniona zawartość pomija tylko oznaczone dane wrażliwe z dowolnej aplikacji."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「忽略的 App」會略過整個 App 的所有內容；「受保護內容」只略過任何 App 中標記為敏感的剪貼簿資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무시하는 App은 해당 App의 모든 복사를 건너뜁니다. 보호된 콘텐츠는 어떤 App이든 민감하다고 표시된 클립보드 데이터만 건너뜁니다."
          }
        }
      }
    },
